#!/usr/bin/env bash

set -eu

# Packs a template into a package
# Adapted from https://github.com/johannes-wolf/cetz/blob/35c0868378cea5ad323cc0d9c2f76de8ed9ba5bd/scripts/package
# licensed under Apache License 2.0

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"; pwd -P)/.." # macOS

TEMPLATE="$2"

if [[ -z "$TEMPLATE" ]]; then
  TEMPLATE="bachelor-thesis"
fi

if [[ ! -d "$ROOT/templates/$TEMPLATE" ]]; then
  echo "Template '$TEMPLATE' does not exist in '$ROOT/templates'."
  exit 1
fi

echo
echo "Processing template $TEMPLATE"

. "$(dirname "${BASH_SOURCE[0]}")/setup" ${2}
. "$(dirname "${BASH_SOURCE[0]}")/template-files"   # expected_for(): the required-file allow-list

TARGET="$(resolve-target "${1:?Missing target path, @local or @preview}")"
echo "Install dir: $TARGET"

# ignore rules
readarray -t ignores < <(grep -v '^#' .typstignore | grep '[^[:blank:]]')

# recursively print all files that are not excluded via .typstignore
function enumerate {
	local root="$1"
	if [[ -f "$root" ]]; then
		echo "$root"
	else
		local files
		readarray -t files < <(find "$root" \
      -mindepth 1 -maxdepth 1 \
      -not -name .git \
      -not -name .typstignore)
		# declare -p files >&2

		local f
		for f in "${files[@]}"; do
			local include
			include=1

			local ignore
			for ignore in "${ignores[@]}"; do
				if [[ "$ignore" =~ ^! ]]; then
					ignore="${ignore:1}"
					if [[ "$f" == ./$ignore ]]; then
						# echo "\"$f\" matched \"!$ignore\"" >&2
						include=1
					fi
				elif [[ "$f" == ./$ignore ]]; then
					# echo "\"$f\" matched \"$ignore\"" >&2
					include=0
				fi
			done
			if [[ "$include" == 1 ]]; then
				enumerate "$f"
			fi
		done
	fi
}

# List of all files that get packaged
readarray -t files < <(enumerate ".")
# declare -p files >&2

TMP="$(mktemp -d)"

for f in "${files[@]}"; do
  mkdir -p "$TMP/$(dirname "$f")" 2>/dev/null
  cp -r "$ROOT/$f" "$TMP/$f"
done

# Copy the specific files in templates to the root directory
cp -a "$ROOT/templates/$TEMPLATE/README.md" "$TMP"
cp -a "$ROOT/templates/$TEMPLATE/typst.toml" "$TMP"

# NOTE: the example PDFs in examples/ are produced fresh by `compile-all` (a pack
# prerequisite). Do NOT copy src/*.pdf over them — those are stray artifacts left
# by running `typst compile src/<x>.typ` with no output path, and are usually stale
# (e.g. predating the colophon), which silently corrupts the committed examples.

# ── Keep ONLY the files this template requires ──────────────────────────────
# The allow-list comes from scripts/template-files (shared with check-pack), so
# packing and the check cannot disagree. Everything copied above that is not on
# the list — other templates' examples, unused figs, sibling thumbnails — is a
# leak and gets pruned here.
echo "Pruning to the required-file set for template $TEMPLATE"
declare -A allow_set
while IFS= read -r rel; do allow_set["$rel"]=1; done < <(expected_for "$TEMPLATE" | LC_ALL=C sort -u)

while IFS= read -r f; do
	rel="${f#$TMP/}"
	if [[ -z "${allow_set[$rel]:-}" ]]; then
		echo "  Pruning $rel"
		rm -f "$f"
	fi
done < <(find "$TMP" -type f)
find "$TMP" -type d -empty -delete

TARGET="${TARGET:?}/${PKG_PREFIX:?}/${VERSION:?}"
echo "Packaged to: $TARGET"

if rm -r "${TARGET:?}" 2>/dev/null; then
  echo "Overwriting existing version."
fi
mkdir -p "$TARGET"

# include hidden files by setting dotglob
shopt -s dotglob

mv "$TMP"/* "$TARGET"
